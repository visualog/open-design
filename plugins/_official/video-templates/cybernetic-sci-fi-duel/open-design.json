    "useCase": {
      "query": "A human fighter battling a powerful humanoid AI robot in a high-tech facility, metal impacts sending sparks flying, powerful punches causing shockwaves, dynamic camera angles, slow motion finishing moves, intense lighting flashes, cinematic VFX, blockbuster sci-fi fight scene, ultra realistic, 4K"
    },
    "inputs": [
      {
        "name": "model",
        "label": "Model",
        "type": "select",
        "options": [
          "seedance-2.0"
