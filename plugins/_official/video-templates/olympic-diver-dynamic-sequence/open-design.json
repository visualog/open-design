{
  "$schema": "https://open-design.ai/schemas/plugin.v1.json",
  "specVersion": "1.0.0",
  "name": "video-template-olympic-diver-dynamic-sequence",
  "title": "Olympic Diver Dynamic Sequence",
  "version": "0.1.0",
  "description": "A video generation prompt for an Olympic diver performing a takeoff and perfect mid-air dive into a blue pool.",
  "license": "CC-BY-4.0",
  "author": {
    "name": "Ratul Ali",
    "url": "https://x.com/Ratul_AI/status/2056969972556222690"
  },
  "homepage": "https://github.com/YouMind-OpenLab/awesome-seedance-2-prompts",
  "tags": [
    "video-template",
    "first-party",
    "video",
    "general",
    "action"
  ],
  "od": {
    "kind": "scenario",
    "taskKind": "new-generation",
    "mode": "video",
    "scenario": "video",
    "surface": "video",
    "preview": {
      "type": "video",
      "poster": "https://customer-qs6wnyfuv0gcybzj.cloudflarestream.com/6c94c3c2e769205b33b44cdd0e47c234/thumbnails/thumbnail.jpg",
      "video": "https://customer-qs6wnyfuv0gcybzj.cloudflarestream.com/6c94c3c2e769205b33b44cdd0e47c234/downloads/default.mp4"
    },
    "useCase": {
      "query": "Female Olympic diver from platform takeoff to mid-air perfect dive into blue pool, full sequence action, colorful swimsuit, dynamic shot."
    },
    "inputs": [
      {
        "name": "model",
        "label": "Model",
        "type": "select",
        "options": [
          "seedance-2.0"
        ],
        "default": "seedance-2.0"
      },
      {
        "name": "aspect",
        "label": "Aspect ratio",
        "type": "select",
        "options": [
          "16:9",
          "9:16",
          "1:1",
          "4:5"
        ],
        "default": "16:9"
      }
    ],
    "context": {
      "assets": [
        "./template.json"
      ]
    },
    "pipeline": {
      "stages": [
        {
          "id": "generate",
          "atoms": [
            "video-generate"
          ]
        }
      ]
    },
    "capabilities": [
      "prompt:inject",
      "media:video-generate"
    ],
    "importedAt": "2026-05-22",
    "localized": {
      "ko": {
        "title": "올림픽 다이버 다이내믹",
        "description": "seedance-2.0 비디오 생성을 위한 범용 프롬프트 템플릿입니다. 카드 제목과 설명은 한국어로 표시하지만 프롬프트 본문은 원문을 유지합니다."
      }
    }
  }
}
