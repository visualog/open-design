{
  "$schema": "https://open-design.ai/schemas/plugin.v1.json",
  "specVersion": "1.0.0",
  "name": "video-template-robot-basketball-slam-dunk",
  "title": "Robot Basketball Slam Dunk",
  "version": "0.1.0",
  "description": "An action-packed sports video prompt featuring a robot player performing a series of dribbles and a powerful dunk.",
  "license": "CC-BY-4.0",
  "author": {
    "name": "雨雲(Amagumo)806 ｜ AI Animer",
    "url": "https://x.com/ai_animer/status/2057089104521924777"
  },
  "homepage": "https://github.com/YouMind-OpenLab/awesome-seedance-2-prompts",
  "tags": [
    "video-template",
    "first-party",
    "video",
    "general",
    "fantasy"
  ],
  "od": {
    "kind": "scenario",
    "taskKind": "new-generation",
    "mode": "video",
    "scenario": "video",
    "surface": "video",
    "preview": {
      "type": "video",
      "poster": "https://customer-qs6wnyfuv0gcybzj.cloudflarestream.com/8b9d7393dbdb37d82e7c231241e1b287/thumbnails/thumbnail.jpg",
      "video": "https://customer-qs6wnyfuv0gcybzj.cloudflarestream.com/8b9d7393dbdb37d82e7c231241e1b287/downloads/default.mp4"
    },
    "useCase": {
      "query": "A basketball game. [Image 1] receives a pass from a teammate. Starts dribbling from the center circle. Bypassing one defender, then another, and finishing with a slam dunk. Multi-shot. Diverse camera work. Shot sizes and camera angles. Effective lighting. Team name is Dogs, opposing team is Cats. Dazzling stadium lights. The stands are full. Effective impact frames. A sense of urgency and tension."
    },
    "inputs": [
      {
        "name": "model",
        "label": "Model",
        "type": "select",
        "options": [
          "seedance-2.0"
        ],
        "default": "seedance-2.0"
      },
      {
        "name": "aspect",
        "label": "Aspect ratio",
        "type": "select",
        "options": [
          "16:9",
          "9:16",
          "1:1",
          "4:5"
        ],
        "default": "16:9"
      }
    ],
    "context": {
      "assets": [
        "./template.json"
      ]
    },
    "pipeline": {
      "stages": [
        {
          "id": "generate",
          "atoms": [
            "video-generate"
          ]
        }
      ]
    },
    "capabilities": [
      "prompt:inject",
      "media:video-generate"
    ],
    "importedAt": "2026-05-22",
    "localized": {
      "ko": {
        "title": "로봇 농구 슬램 덩크",
        "description": "seedance-2.0 비디오 생성을 위한 범용 프롬프트 템플릿입니다. 카드 제목과 설명은 한국어로 표시하지만 프롬프트 본문은 원문을 유지합니다."
      }
    }
  }
}
