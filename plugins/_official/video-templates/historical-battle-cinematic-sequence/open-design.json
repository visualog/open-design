{
  "$schema": "https://open-design.ai/schemas/plugin.v1.json",
  "specVersion": "1.0.0",
  "name": "video-template-historical-battle-cinematic-sequence",
  "title": "Historical Battle Cinematic Sequence",
  "version": "0.1.0",
  "description": "A complex video prompt used to generate a modern blockbuster-style cinematic sequence based on historical tapestry and text inputs.",
  "license": "CC-BY-4.0",
  "author": {
    "name": "Litany of Ignition",
    "url": "https://x.com/LitanyXIgnition/status/2056744656621154427"
  },
  "homepage": "https://github.com/YouMind-OpenLab/awesome-seedance-2-prompts",
  "tags": [
    "video-template",
    "first-party",
    "video",
    "cinematic",
    "fantasy"
  ],
  "od": {
    "kind": "scenario",
    "taskKind": "new-generation",
    "mode": "video",
    "scenario": "video",
    "surface": "video",
    "preview": {
      "type": "video",
      "poster": "https://customer-qs6wnyfuv0gcybzj.cloudflarestream.com/9ea6b266dba13bdc4b5c5f629c91b4e1/thumbnails/thumbnail.jpg",
      "video": "https://customer-qs6wnyfuv0gcybzj.cloudflarestream.com/9ea6b266dba13bdc4b5c5f629c91b4e1/downloads/default.mp4"
    },
    "useCase": {
      "query": "Create a realistic cinematic shot sequence based on the provided historical inputs, Which include the Bayeux Tapestry @image1 , And the Wikipedia entry for the Battle of Hastings. The output should be a cinematic Modern Blockbuster (Sharp, Rich Color): Shot on Arri Alexa, Kodak"
    },
    "inputs": [
      {
        "name": "model",
        "label": "Model",
        "type": "select",
        "options": [
          "seedance-2.0"
        ],
        "default": "seedance-2.0"
      },
      {
        "name": "aspect",
        "label": "Aspect ratio",
        "type": "select",
        "options": [
          "16:9",
          "9:16",
          "1:1",
          "4:5"
        ],
        "default": "16:9"
      }
    ],
    "context": {
      "assets": [
        "./template.json"
      ]
    },
    "pipeline": {
      "stages": [
        {
          "id": "generate",
          "atoms": [
            "video-generate"
          ]
        }
      ]
    },
    "capabilities": [
      "prompt:inject",
      "media:video-generate"
    ],
    "importedAt": "2026-05-22",
    "localized": {
      "ko": {
        "title": "역사 전투 시네마틱",
        "description": "seedance-2.0 비디오 생성을 위한 시네마틱 프롬프트 템플릿입니다. 카드 제목과 설명은 한국어로 표시하지만 프롬프트 본문은 원문을 유지합니다."
      }
    }
  }
}
