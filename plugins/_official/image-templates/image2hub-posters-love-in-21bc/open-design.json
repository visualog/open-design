{
  "$schema": "https://open-design.ai/schemas/plugin.v1.json",
  "specVersion": "1.0.0",
  "name": "image-template-image2hub-posters-love-in-21bc",
  "title": "Image2 영화 포스터 - Love In 21bc",
  "version": "0.1.0",
  "description": "Image2 Hub의 포스터 / 영화 포스터 카테고리에서 가져온 이미지 생성 스타일입니다. 한국어 텍스트가 필요한 장면은 한국어 라벨과 카피를 사용하도록 조정했습니다.",
  "license": "Unspecified",
  "author": {
    "name": "Image2 Hub",
    "url": "https://image2hub.netlify.app/"
  },
  "homepage": "https://github.com/houshifang/image",
  "tags": [
    "image-template",
    "first-party",
    "image",
    "social-media-post",
    "marketing",
    "cinematic"
  ],
  "od": {
    "kind": "scenario",
    "taskKind": "new-generation",
    "mode": "image",
    "scenario": "image",
    "surface": "image",
    "preview": {
      "type": "image",
      "poster": "https://image2hub.netlify.app/assets/posters/love-in-21bc.webp"
    },
    "useCase": {
      "query": "Emulate a master of cinematic poster design, with international film-poster quality. Create a movie poster. Film title: Love in Another Era. Use Korean-language copy, labels, captions, titles, and UI text wherever text appears; keep all text readable and culturally natural for Korean users."
    },
    "inputs": [
      {
        "name": "model",
        "label": "Model",
        "type": "select",
        "options": [
          "gpt-image-2"
        ],
        "default": "gpt-image-2"
      },
      {
        "name": "aspect",
        "label": "Aspect ratio",
        "type": "select",
        "options": [
          "1:1",
          "16:9",
          "9:16",
          "4:5",
          "3:2"
        ],
        "default": "9:16"
      }
    ],
    "context": {
      "assets": [
        "./template.json"
      ]
    },
    "pipeline": {
      "stages": [
        {
          "id": "generate",
          "atoms": [
            "image-generate"
          ]
        }
      ]
    },
    "capabilities": [
      "prompt:inject",
      "media:image-generate"
    ],
    "localized": {
      "ko": {
        "title": "영화 포스터 - 사랑",
        "description": "gpt-image-2 이미지 생성을 위한 소셜 미디어 포스트 프롬프트 템플릿입니다. 카드 제목과 설명은 한국어로 표시하지만 프롬프트 본문은 원문을 유지합니다."
      }
    }
  }
}
